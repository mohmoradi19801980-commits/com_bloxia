<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="5.0" method="upgrade">
    <name>com_bloxia</name>
    <creationDate>2026-11</creationDate>
    <author>Mohsen Sadjadi</author>
    <authorEmail>info@bastangraphic.com</authorEmail>
    <authorUrl>https://bastangraphic.com</authorUrl>
    <copyright>Copyright (C) 2026 BastanGraphic.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>1.0.1</version>
    <description>Bloxia Game Engine and User Dashboard</description>

    <namespace path="src">BastanGraphic\Component\Bloxia</namespace>

    <files folder="site">
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <media destination="com_bloxia" folder="media">
        <folder>js</folder>
        <folder>css</folder>
    </media>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>

    <administration>
        <menu link="option=com_bloxia&amp;view=games">Bloxia Dashboard</menu>
        <submenu>
            <menu link="option=com_bloxia&amp;view=games">مدیریت بازی‌ها</menu>
            <menu link="option=com_bloxia&amp;view=users">کاربران و کیف پول</menu>
            <menu link="option=com_bloxia&amp;view=items">فروشگاه و قیمت‌ها</menu>
            <menu link="option=com_bloxia&amp;view=logs">لاگ فعالیت‌ها</menu>
        </submenu>
        <files folder="admin">
            <folder>src</folder>
            <folder>tmpl</folder>
            <folder>sql</folder>
            <folder>services</folder>
        </files>
    </administration>
</extension>